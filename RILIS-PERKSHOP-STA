-- ==========================================
-- LOGIKA VALIDASI KEY
-- ==========================================
local VALID_KEYS = {
    ["sayangnatta"] = true,
    ["sayangrizal"] = true,
}

local function verifyKey()
    local enteredKey = textBox.Text
    
    if VALID_KEYS[enteredKey] then
        statusLabel.TextColor3 = Color3.fromRGB(70, 255, 70)
        statusLabel.Text = "Key Benar! Memuat script..."
        
        task.wait(1)
        -- Hapus UI Key System setelah sukses
        screenGui:Destroy()
        
        -- PANGGIL SCRIPT UTAMA DI SINI
        -- Contoh: loadstring(game:HttpGet("LINK_RAW_GITHUB_KAMU"))()
        print(loadstring(game:HttpGet("https://raw.githubusercontent.com/eron-rr/serikaengineering/refs/heads/main/PERKSHOPSTA"))())
    else
        statusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        statusLabel.Text = "Key Salah! Coba lagi."
    end
end

-- Hubungkan fungsi ke tombol dan tekan Enter
submitBtn.MouseButton1Click:Connect(verifyKey)
textBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verifyKey()
    end
end)
