local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local playerGui = player:WaitForChild("PlayerGui")
local mainUI = playerGui:WaitForChild("Main")
local perkShopUI = mainUI:WaitForChild("PerkShop")

-- ==========================================
-- 1. BIKIN BUBBLE POP-UP
-- ==========================================
local targetGui = pcall(function() return gethui() end) and gethui() or (pcall(function() return CoreGui end) and CoreGui or playerGui)

if targetGui:FindFirstChild("BubblePerk") then
    targetGui.BubblePerk:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BubblePerk"
screenGui.Parent = targetGui

-- Pakai TextButton biar BISA DIKLIK
local bubble = Instance.new("TextButton")
bubble.Size = UDim2.new(0, 160, 0, 40)
bubble.Position = UDim2.new(0.5, -80, 0.1, 0)
bubble.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
bubble.TextColor3 = Color3.fromRGB(255, 255, 255)
bubble.Text = "Perk Shop (Click / K)"
bubble.Font = Enum.Font.GothamBold
bubble.TextSize = 13
bubble.AutoButtonColor = true -- Animasi default saat diklik
bubble.Active = true
bubble.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = bubble

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Thickness = 1
stroke.Parent = bubble

-- ==========================================
-- 2. FUNGSI TOGGLE (KLIK & KEYBIND K)
-- ==========================================
local function toggleShop()
    if perkShopUI then
        perkShopUI.Visible = not perkShopUI.Visible
    end
end

-- Eksekusi via KLIK BUBBLE:
bubble.MouseButton1Click:Connect(toggleShop)

-- Eksekusi via KEYBIND K:
UserInputService.InputBegan:Connect(function(input, isProcessed)
    if isProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggleShop()
    end
end)

-- ==========================================
-- 3. BUBBLE FULLY DRAGGABLE
-- ==========================================
local dragging = false
local dragInput, dragStart, startPos

bubble.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = bubble.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

bubble.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        bubble.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
