        if isfile and isfile(configFile) then
            local data = HttpService:JSONDecode(readfile(configFile))
            if data then
                if data.AutoServerHop ~= nil then config.AutoServerHop = data.AutoServerHop end
                if data.TargetName ~= nil then config.TargetName = data.TargetName end
            end
        end
    end)

    local function saveConfig()
        pcall(function()
            local data = {
                AutoServerHop = config.AutoServerHop,
                TargetName = config.TargetName
            }
            writefile(configFile, HttpService:JSONEncode(data))
        end)
    end

    -- Queue on Teleport untuk Autoexecute di game / server berikutnya
    local qot = queue_on_teleport or (syn and syn.queue_on_teleport)
    if qot then
