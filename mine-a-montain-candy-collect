        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    end)

    -- FUNGSI GOD MODE, FLY & NOCLIP
    local isGodMode = false
    local isFly = false
    local isNoClip = false
    local noclipConnection = nil

    local function enableGodModeFlyNoClip()
        isGodMode = true
        isFly = true
        isNoClip = true

        -- NoClip Loop (Disable Collision)
        if noclipConnection then noclipConnection:Disconnect() end
        noclipConnection = RunService.Stepped:Connect(function()
            if isNoClip then
                pcall(function()
                    local char = player.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end
        end)

        -- God Mode & Fly Loop
        task.spawn(function()
            while isGodMode do
                pcall(function()
                    local char = player.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hum then
                            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                            hum.PlatformStand = true
                            if hum.Health < hum.MaxHealth and hum.Health > 0 then
                                hum.Health = hum.MaxHealth
                            end
                        end
                        if hrp then
                            hrp.Velocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end)
                task.wait(0.2)
            end
        end)
    end

    local function disableGodModeFlyNoClip()
        isGodMode = false
        isFly = false
        isNoClip = false

        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end

        pcall(function()
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                    hum.PlatformStand = false
                end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end)
    end

    local function getCFrameOfObject(obj)
        if obj:IsA("BasePart") then
            return obj.CFrame
        elseif obj:IsA("Model") then
            return obj:GetModelCFrame() or (obj.PrimaryPart and obj.PrimaryPart.CFrame)
        end
        return nil
    end

    local function teleportTo(cframe)
        local char = player.Character or player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = cframe + Vector3.new(0, 2.5, 0)
        end
    end

    local foundCandies = {}
    local isLive = true
    local isAutoTP = config.AutoServerHop
    local liveThread = nil
    local autoThread = nil
    local joinTime = tick()

    local AutoTPBtn = Instance.new("TextButton")

    -- Fungsi Server Hop Utama
    local function doServerHop()
        isLive = false
        isAutoTP = false
        disableGodModeFlyNoClip()
        StatusLabel.Text = "Status: Mencari server baru untuk Server Hop..."
        saveConfig()
        
        if qot then
            qot([[ task.wait(3) ]])
        end

        local servers = {}
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local response = HttpService:JSONDecode(game:HttpGet(url))
            for _, server in ipairs(response.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
        end)

        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end

    local function scanAndRefresh()
        pcall(function()
            for _, child in ipairs(ScrollingFrame:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            foundCandies = {}
            local targetName = string.lower(TargetBox.Text)
            config.TargetName = TargetBox.Text
            saveConfig()
            
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")

            for _, obj in ipairs(workspace:GetDescendants()) do
                if string.lower(obj.Name) == targetName or (obj.Parent and string.lower(obj.Parent.Name) == targetName) then
                    local cf = getCFrameOfObject(obj)
                    if cf then
                        local dist = rootPart and math.floor((rootPart.Position - cf.Position).Magnitude) or 0
                        table.insert(foundCandies, {Obj = obj, CFrame = cf, Distance = dist})
                    end
                end
            end

            table.sort(foundCandies, function(a, b) return a.Distance < b.Distance end)

            for idx, item in ipairs(foundCandies) do
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 32)
                btn.BackgroundColor3 = Color3.fromRGB(45, 30, 55)
                btn.TextColor3 = Color3.fromRGB(245, 220, 255)
                btn.TextSize = 12
                btn.Font = Enum.Font.SourceSans
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Text = string.format("  [%d] %s | Jarak: %d studs", idx, item.Obj.Name, item.Distance)
                btn.Parent = ScrollingFrame

                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 4)
                btnCorner.Parent = btn

                btn.MouseButton1Click:Connect(function()
                    if item.Obj and item.Obj.Parent then
                        teleportTo(item.CFrame)
                        StatusLabel.Text = "Teleport ke Candy #" .. idx .. "!"
                    else
                        StatusLabel.Text = "Objek sudah tidak ada!"
                    end
                end)
            end

            StatusLabel.Text = "Ditemukan " .. #foundCandies .. " " .. TargetBox.Text .. (isLive and " [LIVE]" or "") .. (isAutoTP and " [AUTO + FLY + NOCLIP]" or "")

            -- Cek Auto Server Hop jika permen habis (Grace period 8 detik)
            if config.AutoServerHop and #foundCandies == 0 and (tick() - joinTime > 8) then
                doServerHop()
            end
        end)
    end

    local function startLiveThread()
        if liveThread then task.cancel(liveThread) end
        liveThread = task.spawn(function()
            while isLive do
                scanAndRefresh()
                task.wait(1.5)
            end
        end)
    end

    local function setAutoTP(state)
        isAutoTP = state
        if isAutoTP then
            enableGodModeFlyNoClip() -- Aktifkan God Mode, Fly, dan NoClip secara otomatis saat Auto TP ON
            AutoTPBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 200)
            AutoTPBtn.Text = "⚡ Auto TP: ON"
            if autoThread then task.cancel(autoThread) end
            autoThread = task.spawn(function()
                while isAutoTP do
                    scanAndRefresh()
                    if #foundCandies > 0 then
                        for _, item in ipairs(foundCandies) do
                            if not isAutoTP then break end
                            if item.Obj and item.Obj.Parent then
                                teleportTo(item.CFrame)
                                task.wait(0.25)
                            end
                        end
                    else
                        task.wait(1)
                    end
                end
            end)
        else
            disableGodModeFlyNoClip() -- Matikan God Mode, Fly, dan NoClip saat Auto TP OFF
            AutoTPBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
            AutoTPBtn.Text = "⚡ Auto TP: OFF"
            if autoThread then
                task.cancel(autoThread)
                autoThread = nil
            end
            scanAndRefresh()
        end
    end

    HopToggleBtn.MouseButton1Click:Connect(function()
        config.AutoServerHop = not config.AutoServerHop
        if config.AutoServerHop then
            HopToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 80)
            HopToggleBtn.Text = "☑️ Auto Server Hop (Jika Kosong): ON"
            setAutoTP(true)
        else
            HopToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            HopToggleBtn.Text = "☐ Auto Server Hop (Jika Kosong): OFF"
        end
        saveConfig()
    end)

