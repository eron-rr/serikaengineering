    LiveBtn.Text = "🔴 Live: ON"
    LiveBtn.Parent = MainFrame

    local LiveCorner = Instance.new("UICorner")
    LiveCorner.CornerRadius = UDim.new(0, 6)
    LiveCorner.Parent = LiveBtn

    LiveBtn.MouseButton1Click:Connect(function()
        isLive = not isLive
        if isLive then
            LiveBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
            LiveBtn.Text = "🔴 Live: ON"
            startLiveThread()
        else
            LiveBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
            LiveBtn.Text = "⚪ Live: OFF"
            if liveThread then task.cancel(liveThread) end
            scanAndRefresh()
        end
    end)

    AutoTPBtn.Size = UDim2.new(0, btnWidth, 0, 36)
    AutoTPBtn.Position = UDim2.new(0, 132, 1, -46)
    AutoTPBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    AutoTPBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    AutoTPBtn.TextSize = 12
    AutoTPBtn.Font = Enum.Font.SourceSansBold
    AutoTPBtn.Text = "⚡ Auto TP: OFF"
    AutoTPBtn.Parent = MainFrame

    local AutoCorner = Instance.new("UICorner")
    AutoCorner.CornerRadius = UDim.new(0, 6)
    AutoCorner.Parent = AutoTPBtn

    AutoTPBtn.MouseButton1Click:Connect(function()
        setAutoTP(not isAutoTP)
    end)

    local ManualHopBtn = Instance.new("TextButton")
    ManualHopBtn.Size = UDim2.new(0, btnWidth, 0, 36)
    ManualHopBtn.Position = UDim2.new(0, 254, 1, -46)
    ManualHopBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    ManualHopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ManualHopBtn.TextSize = 12
    ManualHopBtn.Font = Enum.Font.SourceSansBold
    ManualHopBtn.Text = "🌐 Server Hop"
    ManualHopBtn.Parent = MainFrame

    local HopBtnCorner = Instance.new("UICorner")
    HopBtnCorner.CornerRadius = UDim.new(0, 6)
    HopBtnCorner.Parent = ManualHopBtn

    ManualHopBtn.MouseButton1Click:Connect(function()
        doServerHop()
    end)

    startLiveThread()
    if config.AutoServerHop then
        setAutoTP(true)
    end

    local function toggleUI()
        MainFrame.Visible = not MainFrame.Visible
        OpenBtn.Visible = not MainFrame.Visible
    end

    MinBtn.MouseButton1Click:Connect(toggleUI)
    OpenBtn.MouseButton1Click:Connect(toggleUI)

    CloseBtn.MouseButton1Click:Connect(function()
        isLive = false
        isAutoTP = false
        disableGodModeFlyNoClip()
        if liveThread then task.cancel(liveThread) end
        if autoThread then task.cancel(autoThread) end
        ScreenGui:Destroy()
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.J then
            toggleUI()
        end
    end)

    TargetBox:GetPropertyChangedSignal("Text"):Connect(scanAndRefresh)
    print("[Delta] Candy Teleport Loaded with God Mode, Fly & NoClip!")
end)

if not success then
    warn("Gagal memuat script Teleport UI: " .. tostring(err))
end
